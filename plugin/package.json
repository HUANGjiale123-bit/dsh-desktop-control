{
  "name": "dsh-desktop-control",
  "version": "1.0.2",
  "description": "让 DSH 看见屏幕、操作鼠标键盘，带会话级授权与随时可停的急停机制；另含可选的光标装饰（实验性，默认关闭）",
  "type": "module",
  "main": "index.mjs",
  "license": "MIT",
  "private": true,
  "engines": {
    "node": ">=18"
  },
  "files": [
    "README.md",
    "index.mjs",
    "toolset.mjs",
    "uia-bridge.py",
    "visual-candidates.mjs",
    "ocr-worker.mjs",
    "win-ocr.ps1",
    "tooldsl.mjs",
    "apps.mjs",
    "cordis.patch.yml",
    "bin/dsc.exe",
    "bin/dsc-esc.exe",
    "bin/dsc-fx.exe",
    "bin/dsc-guard.exe",
    "assets/cursor/fish-arrow.png",
    "assets/cursor/poses-arrow",
    "assets/cursor/poses"
  ],
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "dsh",
    "desktop",
    "automation",
    "windows",
    "computer-use",
    "uiautomation"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/HUANGjiale123-bit/dsh-desktop-control.git"
  },
  "homepage": "https://github.com/HUANGjiale123-bit/dsh-desktop-control#readme",
  "bugs": {
    "url": "https://github.com/HUANGjiale123-bit/dsh-desktop-control/issues"
  },
  "author": "north-star(t)"
}
