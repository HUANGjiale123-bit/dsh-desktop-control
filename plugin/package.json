{
  "name": "dsh-desktop-control",
  "version": "0.1.6",
  "description": "Desktop observation and control for DeepSeek Harness on Windows: read a window's accessibility tree, capture it, click and type. Application allowlist, empty by default.",
  "type": "module",
  "main": "index.mjs",
  "license": "SEE LICENSE IN LICENSE",
  "private": true,
  "engines": {
    "node": ">=18"
  },
  "files": [
    "index.mjs",
    "toolset.mjs",
    "cordis.patch.yml"
  ],
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "dsh",
    "desktop",
    "automation",
    "windows",
    "computer-use",
    "uiautomation"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-tools": "*"
  }
}
