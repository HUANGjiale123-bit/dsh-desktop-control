# Windows 辅助进程编译产物
helper/bin/
helper/obj/
*.exe
*.pdb
*.dll
# 但 plugin/bin 下的是**发布产物**：别人 clone 下来打包必须带着，
# 否则包里的 bin/ 是空的，装完所有工具报 HelperMissing（实测过）。
!plugin/bin/
!plugin/bin/*.exe

# Node
node_modules/
plugin/dist/
npm-debug.log*
pnpm-debug.log*

# 编辑器与系统
.vscode/
.idea/
Thumbs.db
desktop.ini

# 运行期产物（截图、缓存、日志）
*.log
/screenshots/
/.cache/

# 临时探测与测试脚本
/.probe/

# 本地配置（可能含应用白名单与路径，不入库）
local.config.json

# 急停闸门等运行期状态
/.state/
dist/
tools/diag/bin/

# 临时探测目录（本地脚本、解包验证）
/.tmp/
__pycache__/

# 本地 profile 备份（含本机路径，不入库）
backup/
